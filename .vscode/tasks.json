      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CPATH": "/opt/homebrew/include"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "swift",
      "args": ["build", "--build-tests", "-Xswiftc", "-diagnostic-style=llvm"],
      "env": {},
      "cwd": "${workspaceFolder}",
      "disableTaskQueue": true,
      "group": "build",
      "problemMatcher": [],
      "label": "swift: Build All",
      "detail": "swift build --build-tests -Xswiftc -diagnostic-style=llvm"
